{
  "name": "swachhsetu-cf-worker",
  "version": "1.0.0",
  "description": "SwachhSetu Cloudflare Worker Backend with Hono and D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute swachhsetu-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute swachhsetu-db --remote --file=./schema.sql",
    "db:seed": "wrangler d1 execute swachhsetu-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute swachhsetu-db --remote --file=./seed.sql",
    "secrets:voice": "node ./scripts/put-voice-secrets.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "@hono/zod-validator": "^0.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
